# Supabase (Project Settings → API). Without these the app runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Cron sends this as a Bearer token to /api/cron/expire
CRON_SECRET=

# Where guests send bank transfers
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# WiPay (card payments — not wired yet, see DECISIONS.md)
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
